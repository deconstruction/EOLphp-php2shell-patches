+/* Unlink temporary upload files without using the allocator.
+ * Called right before _exit(1) on OOM, where normal request shutdown
+ * (and destroy_uploaded_files_hash) never runs. */
+void php_emergency_cleanup_uploaded_files(TSRMLS_D)
+{
+	Bucket *p;
+
+	if (!SG(rfc1867_uploaded_files)) {
+		return;
+	}
+	for (p = SG(rfc1867_uploaded_files)->pListHead; p; p = p->pListNext) {
+		if (p->nKeyLength) {
+			VCWD_UNLINK(p->arKey);
+		}
+	}
+}
